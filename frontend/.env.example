# Set ONLY for cross-domain production deploys (e.g. Vercel frontend +
# Fly backend). When set, lib/api.ts targets this URL directly and the
# Next.js rewrites in next.config.mjs are bypassed.
# Leave empty for local dev — the rewrites proxy /api/* to BACKEND_URL.
NEXT_PUBLIC_API_BASE=
BACKEND_URL=http://localhost:8000
