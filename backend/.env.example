ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=sqlite+aiosqlite:///./compliance.db
USE_CLAUDE=true
USE_THINKING=false
THINKING_BUDGET_TOKENS=2000
ALLOW_ORIGINS=http://localhost:3000

# When true, on first boot the app seeds two demo scans (clinic_policy_weak +
# saas_policy_strong) so a deployed instance lands visitors on populated
# screens instead of an empty upload form. Idempotent; only seeds when the
# scans table is empty.
DEMO_MODE=false
